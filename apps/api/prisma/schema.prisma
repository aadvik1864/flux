generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  EDITOR
  REVIEWER
  VIEWER
}

enum CheckpointKind {
  MANUAL
  BEFORE_RESTORE
  RESTORE
  BEFORE_MERGE
  MERGE
  MERGED_EXPERIMENT
}

enum ActivityKind {
  CHECKPOINT_CREATED
  DOCUMENT_RESTORED
  BRANCH_CREATED
  MERGE_APPROVED
  BRANCH_MERGED
  DECISION_CREATED
  DECISION_STATUS_CHANGED
  DISCUSSION_MESSAGE_REMOVED
}

model User {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String
  emailVerifiedAt DateTime?
  createdAt    DateTime          @default(now())
  sessions     Session[]
  memberships  WorkspaceMember[]
  checkpoints  Checkpoint[]      @relation("CheckpointCreator")
  activities   ActivityEvent[]   @relation("ActivityActor")
  accountTokens AccountToken[]
  experiments Branch[] @relation("ExperimentCreator")
  mergeApprovals MergeApproval[]
  discussionMessages DiscussionMessage[]
  decisions DecisionBookmark[]
}

enum AccountTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

model AccountToken {
  id        String @id @default(cuid())
  tokenHash String @unique
  userId    String
  purpose   AccountTokenPurpose
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

// Operators invite the first workspace owners; workspace invitations admit teammates.
model SignupInvitation {
  id         String @id @default(cuid())
  tokenHash  String @unique
  email      String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime @default(now())
}

// Bearer links are encrypted until delivered, then erased. SMTP is at-least-once.
model EmailMessage {
  id          String @id @default(cuid())
  payload     String?
  attempts    Int @default(0)
  nextAttempt DateTime @default(now())
  sentAt      DateTime?
  createdAt   DateTime @default(now())
  expiresAt   DateTime?
  quarantinedAt DateTime?
  acknowledgedAt DateTime?
  failureKind String?
  retryRequests Int @default(0)

  @@index([sentAt, quarantinedAt, nextAttempt])
}

model AuthThrottle {
  key       String @id
  hits      Int
  expiresAt DateTime

  @@index([expiresAt])
}

model SecurityEvent {
  id        String @id @default(cuid())
  type      String
  userId    String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  description String            @default("")
  createdAt   DateTime          @default(now())
  members     WorkspaceMember[]
  files       File[]
  invitations Invitation[]
  activities  ActivityEvent[]
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        Role
  joinedAt    DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model Invitation {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  workspaceId String
  email       String
  role        Role
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model File {
  id           String    @id @default(cuid())
  workspaceId  String
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  mainBranchId String?   @unique
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  branches     Branch[]  @relation("FileBranches")
  mainBranch   Branch?   @relation("MainBranch", fields: [mainBranchId], references: [id], onDelete: SetNull)
  checkpoints  Checkpoint[]
  activities   ActivityEvent[]

  @@index([workspaceId])
}

model Branch {
  id           String         @id @default(cuid())
  fileId       String
  name         String         @default("main")
  createdAt    DateTime       @default(now())
  file         File           @relation("FileBranches", fields: [fileId], references: [id], onDelete: Cascade)
  mainFor      File?          @relation("MainBranch")
  state        DocumentState?
  generation   Int            @default(0)
  checkpointNumber Int        @default(0)
  checkpoints  Checkpoint[]
  baseCheckpointId String?
  baseCheckpoint Checkpoint? @relation("ExperimentBase", fields: [baseCheckpointId], references: [id], onDelete: NoAction)
  createdById String?
  createdByName String @default("")
  createdBy User? @relation("ExperimentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  archivedAt DateTime?
  requestId String? @unique
  requestHash String?
  approvals MergeApproval[]
  discussionSequence Int @default(0)
  discussionBytes Int @default(0)
  decisionSequence Int @default(0)
  discussionMessages DiscussionMessage[]
  decisions DecisionBookmark[]

  @@unique([fileId, name])
}

// Mutable recovery state. Immutable snapshots are referenced by Checkpoint.
model DocumentState {
  branchId  String   @id
  state     Bytes
  generation Int     @default(0)
  revision   Int     @default(0)
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model Checkpoint {
  id                    String         @id @default(uuid())
  fileId                String
  branchId              String
  number                Int
  title                 String
  kind                  CheckpointKind @default(MANUAL)
  generation            Int
  revision              Int
  schemaVersion         Int
  objectKey             String         @unique
  checksum              String
  byteLength            Int
  createdAt             DateTime       @default(now())
  createdById           String?
  createdByName         String
  requestId             String?        @unique
  requestHash           String?
  sourceCheckpointId    String?
  preservedCheckpointId String?
  file                  File           @relation(fields: [fileId], references: [id], onDelete: Cascade)
  branch                Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy             User?          @relation("CheckpointCreator", fields: [createdById], references: [id], onDelete: SetNull)
  sourceCheckpoint      Checkpoint?    @relation("RestoredFrom", fields: [sourceCheckpointId], references: [id], onDelete: SetNull)
  restoredAs            Checkpoint[]   @relation("RestoredFrom")
  preservedCheckpoint   Checkpoint?    @relation("PreservedBeforeRestore", fields: [preservedCheckpointId], references: [id], onDelete: SetNull)
  preservedBy           Checkpoint[]   @relation("PreservedBeforeRestore")
  experiments           Branch[] @relation("ExperimentBase")
  decisions             DecisionBookmark[]

  @@unique([branchId, number])
  @@index([fileId, createdAt])
}

model MergeApproval {
  id String @id @default(uuid())
  branchId String
  approvedById String?
  approvedByName String
  createdAt DateTime @default(now())
  sourceHead Json
  mainHead Json
  baseChecksum String
  resultContent Json?
  byteLength Int @default(0)
  supersededAt DateTime?
  resultHash String
  resolutions Json
  requestId String @unique
  requestHash String
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  approvedBy User? @relation(fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([branchId, supersededAt])
}

model ActivityEvent {
  id          String       @id @default(cuid())
  workspaceId String
  fileId      String?
  actorId     String?
  actorName   String
  type        ActivityKind
  details     Json
  createdAt   DateTime     @default(now())
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  file        File?        @relation(fields: [fileId], references: [id], onDelete: SetNull)
  actor       User?        @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([fileId, createdAt])
}

model DiscussionMessage {
  id String @id @default(uuid())
  branchId String
  number Int
  authorId String?
  authorName String
  body String
  byteLength Int
  createdAt DateTime @default(now())
  deletedAt DateTime?
  requestId String @unique
  requestHash String
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  decisions DecisionBookmark[]

  @@unique([branchId, number])
}

enum DecisionStatus {
  OPEN
  DECIDED
  SUPERSEDED
}

model DecisionBookmark {
  id String @id @default(uuid())
  branchId String
  number Int
  title String
  explanation String
  status DecisionStatus @default(OPEN)
  createdById String?
  createdByName String
  createdAt DateTime @default(now())
  checkpointId String
  blockId String
  anchorGeneration Int
  anchorIdentity String
  unavailableAt DateTime?
  discussionMessageId String?
  requestId String @unique
  requestHash String
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  checkpoint Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: NoAction)
  discussionMessage DiscussionMessage? @relation(fields: [discussionMessageId], references: [id], onDelete: SetNull)

  @@unique([branchId, number])
  @@index([checkpointId])
}
