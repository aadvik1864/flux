# Copy to deploy/production.env (ignored). Use a real domain pointed at your server.
FLUX_DOMAIN=flux.your-domain.com
APP_ORIGIN=https://flux.your-domain.com
ACME_EMAIL=operator@your-domain.com
COMPOSE_PROJECT_NAME=flux-production
FLUX_TAG=release-1
# Generate each independently: node -p "require('node:crypto').randomBytes(32).toString('hex')"
POSTGRES_ADMIN_PASSWORD=replace-with-random-hex
POSTGRES_APP_PASSWORD=replace-with-random-hex
COLLABORATION_SECRET=replace-with-random-hex
S3_ACCESS_KEY=flux-storage
S3_SECRET_KEY=replace-with-random-hex
MAIL_ENCRYPTION_KEY=replace-with-random-hex
MAIL_FROM=flux@your-domain.com
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-provider-username
SMTP_PASSWORD=replace-with-provider-password
